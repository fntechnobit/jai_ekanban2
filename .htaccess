<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If file/directory doesn't exist at root, forward to public/
    # This ensures storage symlink, assets, and Laravel routes all work
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
